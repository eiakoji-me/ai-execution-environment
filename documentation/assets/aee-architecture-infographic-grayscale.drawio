        <mxCell id="workspace-card" value="&lt;b&gt;workspaces/&amp;lt;workspace&amp;gt;/&amp;lt;item&amp;gt;/&lt;/b&gt;&#xa;&#xa;Persistent specifications, state, context, gates, verification evidence, and artifacts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1020" width="520" height="85" as="geometry"/></mxCell>
        <mxCell id="identity-card" value="&lt;b&gt;.local/state/identities/&amp;lt;id&amp;gt;/&lt;/b&gt;&#xa;&#xa;Host-local credentials; never committed; mounted read-only into the assigned runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1120" width="520" height="85" as="geometry"/></mxCell>

        <mxCell id="context-title" value="Context + state" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111111;spacing=0;" vertex="1" parent="1"><mxGeometry x="630" y="845" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="context-rule" value="" style="shape=line;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="877" width="510" height="1" as="geometry"/></mxCell>
        <mxCell id="stage-state-card" value="&lt;b&gt;Stage state&lt;/b&gt;&#xa;&#xa;meta.json · session-state.md · history.log · artifacts/&#xa;Every stage resumes from files rather than conversation memory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="895" width="510" height="90" as="geometry"/></mxCell>
        <mxCell id="lsm-card" value="&lt;b&gt;LSM context memory&lt;/b&gt;&#xa;&#xa;WAL  →  L0  →  L1  →  L2  →  L3&#xa;&#xa;Events become a bounded prompt, mutable memory, compacted SSTables, then durable decisions and references." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="1000" width="510" height="120" as="geometry"/></mxCell>
        <mxCell id="snapshot-card" value="&lt;b&gt;Snapshots&lt;/b&gt;&#xa;&#xa;Preserve L0, L1, and SSTable manifests so topic switching does not erase working context." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="1135" width="510" height="70" as="geometry"/></mxCell>

