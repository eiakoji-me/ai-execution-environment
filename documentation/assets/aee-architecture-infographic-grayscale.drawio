        <mxCell id="slot-1" value="&lt;b&gt;● Slot 1 · running&lt;/b&gt;&#xa;&#xa;repo-1 / FEAT-42&#xa;Worktree + workspace + identity mounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1350" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="slot-2" value="&lt;b&gt;○ Slot 2 · stopped&lt;/b&gt;&#xa;&#xa;Assignment and container are retained for a later resume." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="1350" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="slot-3" value="&lt;b&gt;● Slot 3 · running&lt;/b&gt;&#xa;&#xa;repo-2 / FIX-108&#xa;Independent trust and Git boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="1350" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="slot-available" value="&lt;b&gt;Available capacity&lt;/b&gt;&#xa;&#xa;Unclaimed until another work item starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;dashed=1;fontColor=#111111;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="890" y="1350" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="stop-note" value="&lt;b&gt;stop&lt;/b&gt; pauses execution while retaining the slot, worktree, branch, commits, and local state." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="1460" width="500" height="45" as="geometry"/></mxCell>
        <mxCell id="close-note" value="&lt;b&gt;close&lt;/b&gt; removes the container and worktree, releases the slot, and keeps the durable workspace." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="610" y="1460" width="530" height="45" as="geometry"/></mxCell>
