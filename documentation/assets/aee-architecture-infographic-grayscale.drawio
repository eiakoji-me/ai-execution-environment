        <mxCell id="storage-rule" value="" style="shape=line;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="877" width="520" height="1" as="geometry"/></mxCell>
        <mxCell id="repo-card" value="&lt;b&gt;repos/&amp;lt;project&amp;gt;/&lt;/b&gt;&#xa;&#xa;Canonical fetch-only clone; pristine checkout and shared object database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;fontColor=#111111;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="895" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="worktree-card" value="&lt;b&gt;worktrees/&amp;lt;item&amp;gt;/&lt;/b&gt;&#xa;&#xa;Disposable branch from the explicit upstream default branch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;fontColor=#111111;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="895" width="240" height="105" as="geometry"/></mxCell>
